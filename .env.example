# Copy this file to .env and fill in your values
# Get your API key from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# Get your Project ID from: watsonx.ai ? Your Project ? Manage tab
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Region URL (change if not using Dallas)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model (do not change unless you know another model is available)
GRANITE_MODEL_ID=ibm/granite-4-h-small

FLASK_APP=app.py
FLASK_DEBUG=false
PORT=5000
